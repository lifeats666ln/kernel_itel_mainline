// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/* itel RS4 (S666LN), from the stock vendor_boot DTB. */

/dts-v1/;
#include "mt6789.dtsi"
#include <dt-bindings/input/input.h>

/ {
	model = "itel RS4";
	compatible = "itel,s666ln", "mediatek,mt6789";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:921600n8";

		#address-cells = <2>;
		#size-cells = <2>;

		/* LK handoff framebuffer */
		framebuffer@ff1a4000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xff1a4000 0x0 ((720 + 16) * 1612 * 4)>;
			width = <720>;
			height = <1612>;
			stride = <((720 + 16) * 4)>;
			format = "a8r8g8b8";
		};
	};

	/* U-Boot clamps gd->ram_size to 2G */
	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x80000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		aee-debug-kinfo@48080000 {
			reg = <0x0 0x48080000 0x0 0x10000>;
			no-map;
		};

		ramoops@48090000 {
			compatible = "ramoops";
			reg = <0x0 0x48090000 0x0 0xe0000>;
			record-size = <0x10000>;
			console-size = <0x40000>;
			pmsg-size = <0x40000>;
		};

		minirdump@48170000 {
			reg = <0x0 0x48170000 0x0 0x10000>;
			no-map;
		};

		bl31@48200000 {
			reg = <0x0 0x48200000 0x0 0x200000>;
			no-map;
		};

		crypto-hw@48401000 {
			reg = <0x0 0x48401000 0x0 0x1000>;
			no-map;
		};

		tee@70000000 {
			reg = <0x0 0x70000000 0x0 0x6000000>;
			no-map;
		};

		consys_emi@7d000000 {
			reg = <0x0 0x7d000000 0x0 0x500000>;
			no-map;
		};

		tee_secmem@7de00000 {
			reg = <0x0 0x7de00000 0x0 0x800000>;
			no-map;
		};

		/* GenieZone hypervisor writes its log here at runtime */
		gz-log@7e600000 {
			reg = <0x0 0x7e600000 0x0 0x41000>;
		};

		gz-unmap2@7e800000 {
			reg = <0x0 0x7e800000 0x0 0x400000>;
			no-map;
		};

		gz@7ec00000 {
			reg = <0x0 0x7ec00000 0x0 0x1200000>;
			no-map;
		};

		mcupm@7feb0000 {
			reg = <0x0 0x7feb0000 0x0 0x100000>;
			no-map;
		};

		emi-mbist@7ffff000 {
			reg = <0x0 0x7ffff000 0x0 0x1000>;
			no-map;
		};

		ap_md_c_smem@8c000000 {
			reg = <0x0 0x8c000000 0x0 0x16a0000>;
			no-map;
		};

		ap_md_nc_smem@8e000000 {
			reg = <0x0 0x8e000000 0x0 0xe10000>;
			no-map;
		};

		scp_share@8f000000 {
			reg = <0x0 0x8f000000 0x0 0x7a0000>;
			no-map;
		};

		sspm_ap_shared@9f560000 {
			reg = <0x0 0x9f560000 0x0 0x110000>;
			no-map;
		};

		debug_met@9f670000 {
			reg = <0x0 0x9f670000 0x0 0x800000>;
			no-map;
		};

		sspm@9fe70000 {
			reg = <0x0 0x9fe70000 0x0 0x180000>;
			no-map;
		};

		wifi_reserve@bf000000 {
			reg = <0x0 0xbf000000 0x0 0x600000>;
			no-map;
		};

		ccci_tag@bf7f0000 {
			reg = <0x0 0xbf7f0000 0x0 0x10000>;
			no-map;
		};

		scp_reserved@bf800000 {
			reg = <0x0 0xbf800000 0x0 0x600000>;
			no-map;
		};

		atf-log@bfe00000 {
			reg = <0x0 0xbfe00000 0x0 0x200000>;
			no-map;
		};
	};
};

&uart0 {
	status = "okay";
};

&soc {
	kpd: keypad@10010000 {
		compatible = "mediatek,mt6789-keypad";
		reg = <0x0 0x10010000 0x0 0x1000>;
		interrupts = <GIC_SPI 106 IRQ_TYPE_EDGE_RISING>;
		clocks = <&clk26m>;
		clock-names = "kpd";
		row-count = <1>;
		column-count = <1>;
		linux,keymap = <MATRIX_KEY(0, 0, KEY_VOLUMEDOWN)>;
		status = "okay";
	};
};

&pwrap {
	status = "okay";

	pmic: pmic {
		compatible = "mediatek,mt6366", "mediatek,mt6358";
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupts-extended = <&pio 137 IRQ_TYPE_LEVEL_HIGH>;

		keys {
			compatible = "mediatek,mt6358-keys";
			mediatek,long-press-mode = <1>;
			power-off-time-sec = <0>;

			power {
				linux,keycodes = <KEY_POWER>;
				wakeup-source;
			};
		};
	};
};

&ufshci {
	status = "okay";
};

&u2phy0 {
	status = "okay";
};

&usb0 {
	status = "okay";
};
