/* itel RS4 (S666LN), from the stock vendor_boot DTB. */

/dts-v1/;
#include "mt6789.dtsi"
#include <dt-bindings/input/input.h>

/ {
	model = "itel RS4";
	compatible = "itel,s666ln", "mediatek,mt6789";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:921600n8";

		#address-cells = <2>;
		#size-cells = <2>;

		/* LK handoff framebuffer */
		framebuffer@ff1a4000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xff1a4000 0x0 ((720 + 16) * 1612 * 4)>;
			width = <720>;
			height = <1612>;
			stride = <((720 + 16) * 4)>;
			format = "a8r8g8b8";
		};
	};

	/* U-Boot clamps gd->ram_size to 2G */
	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x80000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		bl31@48200000 {
			reg = <0x0 0x48200000 0x0 0x200000>;
			no-map;
		};

		tee@70000000 {
			reg = <0x0 0x70000000 0x0 0x6000000>;
			no-map;
		};

		tee_secmem@7de00000 {
			reg = <0x0 0x7de00000 0x0 0x800000>;
			no-map;
		};

		consys_emi@7d000000 {
			reg = <0x0 0x7d000000 0x0 0x500000>;
			no-map;
		};

		ap_md_c_smem@8c000000 {
			reg = <0x0 0x8c000000 0x0 0x16a0000>;
			no-map;
		};

		ap_md_nc_smem@8e000000 {
			reg = <0x0 0x8e000000 0x0 0xe10000>;
			no-map;
		};

		scp_share@8f000000 {
			reg = <0x0 0x8f000000 0x0 0x7a0000>;
			no-map;
		};

		sspm_ap_shared@9f560000 {
			reg = <0x0 0x9f560000 0x0 0x110000>;
			no-map;
		};

		debug_met@9f670000 {
			reg = <0x0 0x9f670000 0x0 0x800000>;
			no-map;
		};

		wifi_reserve@bf000000 {
			reg = <0x0 0xbf000000 0x0 0x600000>;
			no-map;
		};

		ccci_tag@bf7f0000 {
			reg = <0x0 0xbf7f0000 0x0 0x10000>;
			no-map;
		};

		scp_reserved@bf800000 {
			reg = <0x0 0xbf800000 0x0 0x600000>;
			no-map;
		};
	};
};

&uart0 {
	status = "okay";
};

&soc {
	kpd: keypad@10010000 {
		compatible = "mediatek,mt6789-keypad";
		reg = <0x0 0x10010000 0x0 0x1000>;
		interrupts = <GIC_SPI 106 IRQ_TYPE_EDGE_RISING>;
		clocks = <&clk26m>;
		clock-names = "kpd";
		row-count = <1>;
		column-count = <1>;
		linux,keymap = <MATRIX_KEY(0, 0, KEY_VOLUMEDOWN)>;
		status = "okay";
	};
};

&pwrap {
	status = "okay";

	mt6366keys: mt6366-keys {
		compatible = "mediatek,mt6366-keys", "mediatek,mt6358-keys";

		power {
			linux,keycodes = <KEY_POWER>;
			wakeup-source;
		};
	};
};

&ufshci {
	status = "okay";
};
